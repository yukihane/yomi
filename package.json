{
	"name": "yomi",
	"version": "0.2.3",
	"private": true,
	"description": "ChatGPT サブスクリプションで Web ページ全体や選択テキストを翻訳する Chrome・Firefox 拡張",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"firefox:install": "node scripts/install-firefox.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"hero": "node scripts/hero.ts",
		"icons": "node scripts/icons.ts",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"postinstall": "wxt prepare",
		"test": "vitest run --project unit",
		"test:e2e": "vitest run --project e2e --exclude=e2e/firefox/**",
		"test:e2e:firefox": "vitest run --project e2e e2e/firefox/",
		"typecheck": "tsc --noEmit",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox"
	},
	"dependencies": {
		"@wxt-dev/browser": "0.3.4",
		"entities": "8.1.0",
		"idb": "8.0.4",
		"jose": "6.2.12",
		"openai": "7.30.1",
		"solid-js": "1.9.17",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@puppeteer/browsers": "3.2.3",
		"@shun-shobon/oxfmt-config": "7.0.0",
		"@shun-shobon/oxlint-config": "7.0.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/selenium-webdriver": "4.35.7",
		"fake-indexeddb": "6.2.5",
		"happy-dom": "20.14.5",
		"knip": "6.40.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"playwright-core": "1.64.0",
		"selenium-webdriver": "4.50.0",
		"typescript": "7.0.2",
		"vite-plugin-solid": "2.11.14",
		"vitest": "5.0.3",
		"wxt": "0.21.4"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.11.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.10.1"
}
